	(text "*** MONTAJ — SIMULASYONUN GOREMEDIGI UC KURAL ***"
		(at 190.5 190.5 0)
		(effects (font (size 1.9 1.9)) (justify left bottom))
		(uuid "5a764f2c-91a7-45be-98e1-47d2913b6353")
	)
	(text "1) YILDIZ TOPRAK: sontun GND ucu tek toprak noktasidir. ADS'lerin GND'si,"
		(at 190.5 196.85 0)
		(effects (font (size 1.6 1.6)) (justify left bottom))
		(uuid "60da9f21-00cc-471f-a920-3d0d77e070f6")
	)
	(text "   bolucunun alt ucu ve ESP32 GND'si oraya AYRI tellerle gider — yuk akiminin"
		(at 190.5 201.93 0)
		(effects (font (size 1.6 1.6)) (justify left bottom))
		(uuid "c245a024-ea08-44b7-8fb7-010b80c036d1")
	)
	(text "   gectigi iz uzerinden DEGIL. 10 A x 10 mohm iz = 100 mV hata (12 V'ta %0.8)."
		(at 190.5 207.01 0)
		(effects (font (size 1.6 1.6)) (justify left bottom))
		(uuid "2b47fe98-eafa-46fb-814f-86e2a94eafef")
	)
	(text "2) R8/R9 (*DNP): hazir ADS1115 modullerinde kart uzerinde 10K pull-up VAR."
		(at 190.5 213.36 0)
		(effects (font (size 1.6 1.6)) (justify left bottom))
		(uuid "e716b8d2-b292-43a8-8d67-4b4ecb91e80c")
	)
	(text "   Uc modul + 4.7K = 1.95 kohm; 2 kohm sinirinin altina duser. Modul"
		(at 190.5 218.44 0)
		(effects (font (size 1.6 1.6)) (justify left bottom))
		(uuid "ff58f857-00ca-44f9-8976-67142b0398e9")
	)
	(text "   kullaniliyorsa R8/R9 TAKILMAZ. Ciplak cip lehimleniyorsa takilir."
		(at 190.5 223.52 0)
		(effects (font (size 1.6 1.6)) (justify left bottom))
		(uuid "479ac263-4a15-4847-a394-166c3968cdab")
	)
	(text "3) SKOP girisi: ESP32-S3 ADC'si gurultuye duyarli ve dogrusal degil."
		(at 190.5 229.87 0)
		(effects (font (size 1.6 1.6)) (justify left bottom))
		(uuid "e25a89a9-9b6f-4992-a47f-cca4ddd3543f")
	)
	(text "   Temiz dalga sekli isteniyorsa NS dugumu ile GPIO4 arasina TL072 gerilim"
		(at 190.5 234.95 0)
		(effects (font (size 1.6 1.6)) (justify left bottom))
		(uuid "90db8b6d-521d-4f36-9157-1712968cbf61")
	)
	(text "   izleyici koy (+-12 V raydan). Tamponsuz da calisir, sadece gurultulu."
		(at 190.5 240.03 0)
		(effects (font (size 1.6 1.6)) (justify left bottom))
		(uuid "6a4f0036-4085-4037-9981-259cccf7d952")
	)
	(text "Asama 2 — tum degerler uretim/tasarim2.py (24/24) ve uretim/sim2_giris.py (11/11) ile dogrulandi."
		(at 25.4 190.5 0)
		(effects (font (size 1.7 1.7)) (justify left bottom))
		(uuid "428ebc27-83ff-4f87-8db2-4a2689f280d6")
	)
	(text "Bolucu 15.71:1 SECIMDIR: 11:1 olsaydi TL431 kelepcesi 29.7 V'ta sizip menzili keserdi (A2, secenek C)."
		(at 25.4 195.58 0)
		(effects (font (size 1.7 1.7)) (justify left bottom))
		(uuid "a1b8b8eb-865f-4b2b-bc71-a5ed3b6b8cd9")
	)
	(text "ADS1115 3.3 V'ta besleniyor — 5 V'ta VIH 3.5 V olur ve ESP32'nin 3.3 V'luk cikisi yetmezdi."
		(at 25.4 200.66 0)
		(effects (font (size 1.7 1.7)) (justify left bottom))
		(uuid "fb9dda52-3027-4578-8841-6e30348820ac")
	)
