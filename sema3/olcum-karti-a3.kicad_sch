		(effects (font (size 1.5 1.5)) (justify left bottom))
		(uuid "50e94bbe-6609-477b-a2b2-b433c191192f")
	)
	(text "!!! TO-220 TABI VI (-12 V) PININDE — 78xx'ten FARKLI. Sogutucuya VIDALAMA. Pin sirasi GND-VI-VO."
