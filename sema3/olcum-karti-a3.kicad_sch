	(text "BAT85 (DO-34 EKSENEL, delikli) — BAT54 SOT-23 oldugu icin secilmedi."
		(at 137.16 236.22 0)
		(effects (font (size 1.5 1.5)) (justify left bottom))
		(uuid "eac933a5-b513-547d-977a-560983a4164f")
	)
	(text "1N4148 OLMAZ: B2 olctu, ariza akiminin %25'i ADS'in ic ESD diyoduna"
		(at 137.16 241.3 0)
		(effects (font (size 1.5 1.5)) (justify left bottom))
		(uuid "fa2c32c1-2fbf-585c-a88b-ef0aab26f43c")
	)
	(text "gidiyor. BAT85 ile pin -0.268 V'ta kaliyor, ESD payi ~%0."
		(at 137.16 246.38 0)
		(effects (font (size 1.5 1.5)) (justify left bottom))
		(uuid "f44ae7f4-ebbc-5d84-bde6-fee4311e3ad0")
	)
	(text "Seri direnc 2.7K: 1K olsaydi +-12 V arizada 11.3 mA — sinir 10 mA."
		(at 137.16 251.46 0)
		(effects (font (size 1.5 1.5)) (justify left bottom))
		(uuid "ed23963d-81e4-5def-9dc8-aeff57b2a3f8")
	)
	(text "Sallen-Key f0 16.55 kHz, Q 0.707. Eski tek kutuplu RC 25 kHz'teydi —"
		(at 137.16 256.54 0)
		(effects (font (size 1.5 1.5)) (justify left bottom))
		(uuid "05619bfe-7356-5903-a213-8b27a75f7892")
	)
	(text "Nyquist'in (20.83 kHz) USTUNDE, yani hicbir sey suzmuyordu (4.8)."
		(at 137.16 261.62 0)
		(effects (font (size 1.5 1.5)) (justify left bottom))
		(uuid "ac5ab0a0-ceb6-548e-90e3-944fe7d93206")
	)
	(text "BLOK 8  —  Hizli akim yolu: fark yukselteci -> Sallen-Key -> GPIO5"
