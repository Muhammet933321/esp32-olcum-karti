// Curutucu 6 (2026-10-05): "veri gelmezken kayit sayaci DONAR" iddiasinin KIRMIZI kanitlari.
// Ayrinti: BULGULAR.md (C6-3, C6-4, C6-5). Uretim kodu duzelince yesile donerler.
// Kabuk GERCEK canli.js ile kurulur (durdur_gorunur.test.js'teki sahte canli, `baslat()`i her cagrida
// "baglaniyor"a cektigi icin C6-3'u gizliyor: gercek canli zaten calisirken `baslat` hicbir sey yapmaz).
import { describe, it, expect } from "vitest";
import { canliKur } from "../../src/cekirdek/canli.js";
import { VERI_ESKI_MS } from "../../src/cekirdek/pil_durum.js";
import { baglantiGorunumu, kayitGorunumu } from "../../src/ekran/durum_gorunum.js";
import { kabukDurumu } from "../../src/ekran/kabuk_durum.js";

const KIMLIK = "0123456789abcdef";
const T = 1_000_000;
const bosalt = () => new Promise((c) => setTimeout(c, 0));
const D = (v) => `D ${v}.0000 0.500000 6.00000 1.0000 0.0002778 1000 97 0 0`;
const G_BOS = "G 1 0 0 61300 61276 137 4 0 1850 24100 3 912 0 0 0";
const G_KAYIT = (oturum, nokta) => `G 2 ${oturum} ${nokta} 61300 61276 137 4 0 1850 24100 3 912 0 0 0`;
const saniye = (sure) => sure.split(":").reduce((t, x) => t * 60 + Number(x), 0);

async function duzen() {
  const saat = { ms: T };
  const kart = {
    d: { durum: "bagli", adres: "192.168.1.7:80", kimlik: KIMLIK },
    durum() { return this.d; },
    async baglan() { return { ...this.d, bilgi: {} }; },
    async istek() { return { status: 204, json: async () => ({ oturumlar: [] }) }; },
  };
  const dinleyici = {};
  const canli = canliKur({
    kart, simdiMs: () => saat.ms, akisUrlAl: async () => "http://192.168.1.7/akis",
    ag: { akisAc: async () => ({ kimlik: "a1" }), akisKapat: async () => {} },
    eklenti: { addListener: (ad, fn) => { dinleyici[ad] = fn; return Promise.resolve(); } },
    zamanla: () => ({}), zamaniBirak: () => {},              // bekci / yeniden deneme bu testlerde atesi almaz
  });
  const aralik = { fn: null };
  const k = kabukDurumu({
    kartAl: async () => kart, canliAl: async () => canli, belge: null, simdiMs: () => saat.ms,
    araliKur: (fn) => { aralik.fn = fn; return 1; }, araliSil: () => { aralik.fn = null; },
  });
  await k.ac(); await bosalt(); await bosalt();
  dinleyici.akisDurum({ kimlik: "a1", hal: "acik" });
  let v = 10;
  const s = {
    k, saat,
    satir: (...satirlar) => dinleyici.akis({ kimlik: "a1", satirlar }),
    olcum: () => dinleyici.akis({ kimlik: "a1", satirlar: [D(++v)] }),
    tik: async (ms = 1000) => { saat.ms += ms; aralik.fn(); await bosalt(); },
    kayit: () => kayitGorunumu(k.akis.value.kayit, k.izleme.value, k.simdi.value, { taze: k.akis.value.hal === "acik", sonGorulmeMs: k.sonGorulme.value }),
    baglanti: () => baglantiGorunumu({ baglanti: k.baglanti.value, araniyor: k.araniyor.value, akis: k.akis.value, sonGorulmeMs: k.sonGorulme.value, simdiMs: k.simdi.value }),
  };
  expect(k.akis.value.hal).toBe("acik");
  return s;
}

// Kayit basladigi GORULDU (BOS -> KAYIT), 10 s veri akti, sonra veri kesildi.
async function kayittaVeriKesildi() {
  const s = await duzen();
  s.satir(G_BOS, D(1)); await s.tik();
  s.satir(G_KAYIT(81, 0)); s.olcum();
  for (let i = 1; i <= 10; i++) { await s.tik(); s.satir(G_KAYIT(81, i)); s.olcum(); }
  expect(s.kayit()).toMatchObject({ suruyor: true, rozet: "cn.kayit_suruyor", sure: "00:00:10" });
  return s;
}

describe("C6-3: 'Yeniden dene' veri GELMEDEN 'son veri'yi simdiye ceker, sayaci ileri sicratir", () => {
  it("veri gelmiyorken 'Yeniden dene'ye basmak sayaci OYNATMAZ, 'son veri' yasini SIFIRLAMAZ", async () => {
    const s = await kayittaVeriKesildi();
    for (let i = 0; i < 30; i++) await s.tik();                              // 30 s veri yok
    const donmus = s.kayit();
    expect(donmus).toMatchObject({ rozet: "m.dr.kayit_suruyordu", sure: "00:00:10" });
    expect(donmus.sonVeri).toEqual({ anahtar: "m.dr.once_sn", degerler: { n: 30 } });
    expect(s.baglanti()).toMatchObject({ anahtar: "m.dr.veri_yok", yeniden: true });   // dugme GORUNUR

    await s.k.yenidenBaglan();                                               // Durum.vue:46 `@click="kabuk.yenidenBaglan()"`
    await bosalt();

    // Karttan TEK satir gelmedi; ekran ayni kalmali.
    const sonra = s.kayit();
    expect(s.k.akis.value.hal, "akis hali").toBe("eski");
    expect(sonra.sure, "sayac").toBe("00:00:10");
    expect(sonra.rozet).toBe("m.dr.kayit_suruyordu");
    expect(sonra.sonVeri).toEqual({ anahtar: "m.dr.once_sn", degerler: { n: 30 } });
  });

  it("basildiktan sonra da: 'son veri' yasi dugmeye basilan andan DEGIL son veriden sayilir", async () => {
    const s = await kayittaVeriKesildi();
    for (let i = 0; i < 30; i++) await s.tik();
    await s.k.yenidenBaglan(); await bosalt();
    for (let i = 0; i < 10; i++) await s.tik();                              // yine veri yok: yeniden "eski"
    const g = s.kayit();
    expect(g.rozet).toBe("m.dr.kayit_suruyordu");
    expect(g.sure, "donmus sayac son verinin aninda kalmali").toBe("00:00:10");
    expect(g.sonVeri).toEqual({ anahtar: "m.dr.once_sn", degerler: { n: 40 } });
    expect(s.baglanti().gecen).toEqual({ anahtar: "m.dr.once_sn", degerler: { n: 40 } });
  });
});

describe("C6-4: veri kesildikten sonraki ilk saniyelerde sayac ilerler, sonra GERI sarar", () => {
  it("veri gelmezken sayac hic ilerlemez / gosterilen sure asla azalmaz", async () => {
    const s = await kayittaVeriKesildi();
    const gorulen = [];
    for (let i = 0; i < 12; i++) { await s.tik(); gorulen.push(saniye(s.kayit().sure)); }
    // Son veri 00:00:10'da geldi. Veri yokken gosterilen en buyuk sure bundan buyuk olmamali ...
    expect(Math.max(...gorulen), `gorulen: ${gorulen.join(",")}`).toBe(10);
    // ... ve gosterilen sure geri gitmemeli.
    for (let i = 1; i < gorulen.length; i++) expect(gorulen[i], `gorulen: ${gorulen.join(",")}`).toBeGreaterThanOrEqual(gorulen[i - 1]);
    expect(VERI_ESKI_MS).toBe(5000);
  });
});

describe("C6-5: veri yokken BASLAMIS kayit, veri donunce 'simdi basladi' sayilir", () => {
  it("baslangici GORULMEYEN kaydin suresi 0'dan saydirilmaz", async () => {
    const s = await duzen();
    s.satir(G_BOS, D(1)); await s.tik(); s.olcum();
    for (let i = 0; i < 3600; i += 60) await s.tik(60_000);                  // 1 saat veri yok ("Kayit yok" donmus)
    expect(s.kayit()).toMatchObject({ suruyor: false, rozet: "m.dr.kayit_yok" });
    expect(s.kayit().sonVeri).not.toBe(null);
    // Veri dondu: kart 3000 nokta toplamis bir kaydin ICINDE (kayit telefon gormezken basladi).
    s.satir(G_KAYIT(82, 3000)); s.olcum();
    await s.tik(); s.satir(G_KAYIT(82, 3001)); s.olcum();
    await s.tik(); s.satir(G_KAYIT(82, 3002)); s.olcum();
    const g = s.kayit();
    expect(g).toMatchObject({ suruyor: true, rozet: "cn.kayit_suruyor", oturum: 82 });
    // kayitIzle'nin kendi kurali: "ilk G'de kayit zaten suruyorduysa [baslangic] bilinmez (sure tahmin edilmez)".
    expect(s.k.izleme.value.basMs, "baslangic ani uyduruldu").toBe(null);
    expect(g.sure, "3000 noktalik kayit icin gosterilen sure").not.toBe("00:00:02");
  });
});
